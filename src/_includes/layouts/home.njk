cat > src/_includes/layouts/home.njk << 'EOF'
{% extends "base.njk" %}

{% block content %}
<section class="hero">
  <h1>Clinical reference <em>&amp; tools</em></h1>
  <div class="hero-search">
    <span class="ico">⌕</span>
    <input type="text" id="siteSearch" placeholder="Search topics, medications, calculators…" autocomplete="off" aria-label="Search the index">
  </div>
</section>

<section class="toc">
  <div class="toc-noresults" id="noRes" style="display:none">No results.</div>

  <div class="section-label">Core reference</div>
  <a href="/topics/" class="toc-entry">
    <span class="entry-num">01</span>
    <div class="entry-body">
      <div class="entry-cat">Guidelines</div>
      <div class="entry-title">NZ Guideline Comparisons</div>
      <div class="entry-desc">NZ, Australian and international guidance alignment and divergence.</div>
    </div>
    <div class="entry-meta">
      <span class="entry-tag">{{ collections.topics | length }} topics</span>
    </div>
  </a>
</section>
{% endblock %}