---
layout: base
---

<div class="wrap">
  <section class="hero">
    <h1>{{ title }}</h1>
    <div class="hero-search">
      <span class="ico">⌕</span>
      <input type="text" id="siteSearch" placeholder="Search topics, tools, essays…" autocomplete="off" aria-label="Search the index">
    </div>
  </section>

  <section class="toc">
    {% set grouped = nav.main | groupby('category') %}
    {% for group in grouped %}
    <div class="section-label">{{ group.list[0].category | upper }}</div>
    {% for item in group.list %}
    {% if item.comingSoon %}
    <div class="toc-entry" style="opacity: 0.5; cursor: not-allowed; pointer-events: none;">
      <span class="entry-num">{{ item.num }}</span>
      <div class="entry-body">
        <div class="entry-cat">{{ item.label }}</div>
        <div class="entry-title">{{ item.title }}</div>
        <div class="entry-desc">{{ item.description }} <span style="font-family: var(--font-mono); font-size: 0.75em; color: var(--muted);">[Coming soon]</span></div>
      </div>
      <div class="entry-meta">
        <span class="entry-tag">Soon</span>
        <span class="entry-arrow">→</span>
      </div>
    </div>
    {% else %}
    <a href="{{ item.url }}" class="toc-entry">
      <span class="entry-num">{{ item.num }}</span>
      <div class="entry-body">
        <div class="entry-cat">{{ item.label }}</div>
        <div class="entry-title">{{ item.title }}</div>
        <div class="entry-desc">{{ item.description }}</div>
      </div>
      <div class="entry-meta">
        {% if collections[item.collection] %}
        <span class="entry-tag">{{ collections[item.collection] | count }} {{ item.label | lower }}</span>
        {% endif %}
        <span class="entry-arrow">→</span>
      </div>
    </a>
    {% endif %}
    {% endfor %}
    {% endfor %}
  </section>
</div>

<script>
  (function() {
    const search = document.getElementById('siteSearch');
    if (!search) return;
    const toc = document.querySelector('.toc');
    const entries = [...toc.querySelectorAll('.toc-entry')];
    const labels = [...toc.querySelectorAll('.section-label')];

    function apply() {
      const q = search.value.trim().toLowerCase();
      entries.forEach(e => {
        e.style.display = (!q || e.textContent.toLowerCase().includes(q)) ? '' : 'none';
      });
      labels.forEach(lab => {
        let n = lab.nextElementSibling, anyVisible = false;
        while (n && !n.classList.contains('section-label')) {
          if (n.classList.contains('toc-entry') && n.style.display !== 'none') {
            anyVisible = true;
            break;
          }
          n = n.nextElementSibling;
        }
        lab.style.display = anyVisible ? '' : 'none';
      });
    }

    search.addEventListener('input', apply);
    search.addEventListener('keydown', ev => {
      if (ev.key === 'Enter') {
        const vis = entries.filter(e => e.style.display !== 'none' && e.tagName === 'A' && e.getAttribute('href'));
        if (vis.length) window.location.href = vis[0].getAttribute('href');
      }
    });
  })();
</script>
