---
layout: base
layoutCss: layouts.css
---

<div class="article article-narrow">
  {% if breadcrumb %}
  <div class="wd-breadcrumb">
    <a href="/">HOME</a> · <b>{{ breadcrumb }}</b>
  </div>
  {% endif %}

  <header class="wd-pagehead">
    <div style="font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: var(--space-lg);">
      Field Notes · Essay
    </div>
    <h1 class="wd-pagetitle">{{ title }}</h1>
    {% if description %}
    <p style="font-size: var(--text-lg); font-style: italic; color: var(--ink-soft); line-height: 1.6; max-width: 700px; margin: var(--space-md) 0;">
      {{ description }}
    </p>
    {% endif %}
    {% if publishedDate or updatedDate or readTime %}
    <div class="wd-pagemeta">
      {% if publishedDate %}
      <span>Published {{ publishedDate | dateShort }}</span>
      {% endif %}
      {% if updatedDate %}
      <span>Updated {{ updatedDate | dateShort }}</span>
      {% endif %}
      {% if readTime %}
      <span>⏱ {{ readTime }} min read</span>
      {% endif %}
    </div>
    {% endif %}
  </header>

  <div style="column-count: 2; column-gap: 32px; column-rule: 1px solid var(--line);">
    {{ content | safe }}
  </div>
</div>
