---
layout: base
layoutCss: layouts.css
---

<div class="article article-narrow">
  {% if breadcrumb %}
  <div class="wd-breadcrumb">
    <a href="/">HOME</a> · <b>{{ breadcrumb }}</b>
  </div>
  {% endif %}

  <header class="wd-pagehead">
    <h1 class="wd-pagetitle">{{ title }}</h1>
    {% if description %}
    <p style="font-size: var(--text-lg); font-style: italic; color: var(--ink-soft); line-height: 1.6;">
      {{ description }}
    </p>
    {% endif %}
  </header>

  {{ content | safe }}
</div>
